# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase PostgreSQL connection when hosting externally (e.g., on Vercel)
SUPABASE_DB_URL=""
SUPABASE_DB_HOST=""
SUPABASE_DB_PORT="6543"
SUPABASE_DB_USER=""
SUPABASE_DB_PASSWORD=""
SUPABASE_DB_NAME="postgres"

# Optional comma-separated list of authorized admin Google emails
ADMIN_EMAILS=""

# Server-side initial Admin Dashboard passcode (overrides first-run claimed password if set)
ADMIN_PASSCODE=

# Optional SMTP email delivery configuration for forwarding enquiries to Oasistravel46@gmail.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Oasis Travel Consultancy <noreply@oasistraveldubai.com>"
ENQUIRY_RECIPIENT_EMAIL="Oasistravel46@gmail.com"
